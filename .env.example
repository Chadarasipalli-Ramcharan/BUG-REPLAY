# PostgreSQL connection string (required)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Comma-separated list of origins allowed to use the ingestion API
# cross-origin (the SDK on other websites). No wildcard.
# Example: BUGREPLAY_CORS_ORIGINS=https://your-site.com,http://localhost:5173
BUGREPLAY_CORS_ORIGINS=

# Set to "production" to disable the destructive demo reset endpoint.
# Leave unset (or anything else) for local development.
# BUGREPLAY_ENV=production
